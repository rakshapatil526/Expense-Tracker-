# Backend Environment Configuration
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'postgres'
DB_ENGINE=postgres

# PostgreSQL Settings (when DB_ENGINE=postgres)
DB_NAME=expensetracker_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
